{
  "steps": [
    {
      "id": "submit_ticket",
      "request": {
        "method": "POST",
        "url": "/support.php",
        "form": {
          "name": "Fieldkit canary",
          "body": "{{payload}}"
        }
      },
      "expect": { "statuses": [200, 201] },
      "extract": {
        "ticket_id": { "source": "json", "pointer": "/ticket_id", "public": true }
      }
    }
  ],
  "browser": { "url": "/ticket.php?id={{ticket_id}}", "profile": "anonymous" }
}
