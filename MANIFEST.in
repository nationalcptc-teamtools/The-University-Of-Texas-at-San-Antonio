include README.md AGENTS.md pyproject.toml MANIFEST.in .gitattributes .gitleaks.toml
recursive-include docs/harness *.md *.txt *.json *.lock
recursive-include docs/harness/portcast-vendor-inputs/files *
recursive-include scripts *.py *.md
recursive-include testing *.py
include testing/cptc11_lab/README.md testing/cptc11_lab/portcast-live-plan-v1.json testing/cptc11_lab/portcast-live-plan-v2.json testing/cptc11_lab/portcast-live-plan-v3.json
recursive-include testing/cptc11_readonly_wave_v1 *.json *.md
recursive-include deployment *
recursive-include cptc11_readonly_wave_v1 *.py *.json
include cptc_harness/profile_runtime/README.md
include cptc_harness/audit_readonly.py
recursive-include cptc_harness/profiles *.md *.json
include cptc_harness/resources/portcast-bootstrap-v1.sha256
include cptc_harness/resources/portcast-cpython-runtime-v1.json
recursive-include vendor/portcast-python3.14/site-packages *
recursive-include vendor/portcast-rootfs-runtime *
recursive-include vendor/corresponding-source *.tar.gz
recursive-include docs/harness/corresponding-source *.json
recursive-include cptc_harness/native *.c *.sh
recursive-include skills/cptc-harness *.md
recursive-include tests *.py *.json *.xml *.md *.bin
global-exclude __pycache__ *.py[cod] *.sqlite3 *.sqlite3-* .DS_Store
prune .tools
prune .superpowers
prune .worktrees
prune testing/cptc11_benchmark
exclude testing/benchmark.py
exclude scripts/benchmark-harness.py
exclude docs/harness/TOKEN-BENCHMARK.json
exclude docs/harness/CPTC11-IMAGE-AUDIT.md
