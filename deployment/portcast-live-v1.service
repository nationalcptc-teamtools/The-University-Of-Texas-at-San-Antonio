[Unit]
Description=CPTC Harness canonical PortCast one-shot authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=_cptc-portcast
Group=cptc-harness
UMask=0077
RuntimeDirectory=cptc-harness
RuntimeDirectoryMode=0750
LoadCredentialEncrypted=cptc11-dell:/etc/cptc-harness/credentials/cptc11-dell.cred
LoadCredentialEncrypted=cptc11-kali:/etc/cptc-harness/credentials/cptc11-kali.cred
RootDirectory=/usr/lib/cptc-harness/portcast-live-v1
MountAPIVFS=yes
ExecStartPre=+/app/deployment/portcast-bootstrap --admit-start
ExecStart=/app/deployment/portcast-bootstrap
UnsetEnvironment=LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE GODEBUG GOENV GOTRACEBACK
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=no
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=no
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=all
RemoveIPC=yes
BindReadOnlyPaths=/etc/cptc-harness/trust/portcast-live-v1.sha256
BindReadOnlyPaths=/run/cptc-harness-clock/portcast-live-v1.json
BindPaths=/run/cptc-harness
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v1/deployment.lock
BindPaths=/var/lib/cptc-harness/portcast-live-v5/admission:/var/lib/cptc-harness/portcast-live-v1/admission
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v5/admission-projection:/var/lib/cptc-harness/portcast-live-v1/admission-projection
# The v5 coordinator owns the new runtime. Keep the historical v1 ledger and
# predecessor runtimes immutable inputs. Do not replace these entries with a
# broad state bind.
BindPaths=/var/lib/cptc-harness/portcast-live-v5/runtime:/var/lib/cptc-harness/portcast-live-v1/runtime/v5
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v4/runtime:/var/lib/cptc-harness/portcast-live-v1/runtime/v4
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v3/runtime:/var/lib/cptc-harness/portcast-live-v1/runtime/v3-predecessor
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v1/runtime/ledger/cptc11-dell-validation:/var/lib/cptc-harness/portcast-live-v1/runtime/ledger/cptc11-dell-validation
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v1/runtime/runtime/audit:/var/lib/cptc-harness/portcast-live-v1/runtime/runtime/audit
# The continuation verifier opens the result through its parent directory to
# defend against file replacement. Mount that service-owned directory as one
# immutable object; a file-only bind leaves the release image's root-owned
# parent visible and correctly fails the verifier's ownership check.
BindReadOnlyPaths=/var/lib/cptc-harness/portcast-live-v1/runtime/runtime/results:/var/lib/cptc-harness/portcast-live-v1/runtime/runtime/results
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
IPAddressDeny=any
IPAddressAllow=100.85.84.30/32
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=mnt ipc net pid user uts
RestrictSUIDSGID=no
SystemCallArchitectures=native
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
